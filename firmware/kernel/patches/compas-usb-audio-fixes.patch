+bool snd_usb_force_interface_reset(struct usb_device *dev)
+{
+	unsigned int id = USB_ID(le16_to_cpu(dev->descriptor.idVendor),
+				le16_to_cpu(dev->descriptor.idProduct));
+
+	if (id == USB_ID(0x05ac, 0x110b))
+		return dev->manufacturer &&
+			!strcmp(dev->manufacturer, "JKY Technology");
+
+	switch (id) {
+	case USB_ID(0x001f, 0x0b21): /* AB13X USB Audio */
+	case USB_ID(0x001f, 0x0b23): /* AB17X USB Audio */
+	case USB_ID(0x0020, 0x0b21): /* GHW-123P */
+	case USB_ID(0x0124, 0x0c21): /* Generic USB Headphone */
+	case USB_ID(0x0124, 0x0c36): /* RYDZ Technology USB Headphone */
+	case USB_ID(0x0624, 0x3d3f): /* AB13X USB Audio */
+	case USB_ID(0x0644, 0x8044): /* Esoteric D-05X */
+	case USB_ID(0x0644, 0x8047): /* TASCAM US-16x08 */
+	case USB_ID(0x0644, 0x805f): /* TEAC Model 12 */
+	case USB_ID(0x0644, 0x806b): /* TEAC UD-701 */
+	case USB_ID(0x0644, 0x807d): /* TEAC UD-507 */
+	case USB_ID(0x0644, 0x806c): /* Esoteric XD */
+	case USB_ID(0x0666, 0x0880): /* SPACETOUCH USB Audio */
+	case USB_ID(0x1237, 0x17b8): /* rongyuan GS20 */
+	case USB_ID(0x12d1, 0x3a07): /* HUAWEI USB-C HEADSET */
+	case USB_ID(0x25aa, 0x600b): /* TAE1159 */
+	case USB_ID(0x3302, 0x17c2): /* TTGK Technology USB-C Audio */
+	case USB_ID(0x36f9, 0xc009): /* XIBERIA K03S */
+	case USB_ID(0x3c20, 0x3d21): /* AB13X USB Audio */
+		return true;
+	default:
+		return false;
+	}
+}
