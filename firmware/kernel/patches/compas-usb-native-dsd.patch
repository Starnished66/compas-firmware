From: Compas maintainers
Subject: [PATCH] ALSA: usb-audio: extend native DSD support

Retain the contained Linux v5.10 native DSD backport and add current Linux
fixed-ID, ITF mode-switch, and DSD_RAW coverage. Resolve exact device exclusions
before vendor matches without importing the quirk-flags framework.

Current upstream: d48723711bae9b8cdc56719c448ba42fef28cbee
Upstream: 3a572d94bcff98a14c94fe686881a169a26f3fca
Upstream: f332485fb37baecc3e2e598870f33d06c15a74f3
Upstream: 1ea0358ecb848058b35b6da13d7f4c08610a73a8
Upstream: 3eff682d765b496ce2f9727bb1e001ec77b21453
Upstream: f83914fdfcc3ecb62a5a83eeb609ff59a9c2052d
Upstream: f3b906d720e429a3acd95f8cbd4fda366fb1659d
Upstream: f7fea075edfa085c25eb34c44ceacf3602537f98
Upstream: da3a7efff64ec0d63af4499eea3a46a2e13b5797
Upstream: 93b47e66cc6d6c6382d44b44f5e7f6fc3a7b38c3
Upstream: bc5b4e5ae1a67700a618328217b6a3bd0f296e97
Upstream: af79b081ce332a3cb0e5c11b7666c6af5d5f4cbc
Upstream: 21a9ab5b90b3716a631d559e62818029b4e7f5b7
Upstream: fe7cd89f0e29f0852316857b4861309f9b891370
Upstream: 4e1462e7cd6a9b920f441842726cc2b9d232673e
Upstream: d24b03248ac6f02fb87feff6beec0b5b1da5dafd
Upstream: 8362d65141d275d2907f1610a3cd2becb7ae2c83
Source: https://github.com/torvalds/linux/blob/d48723711bae9b8cdc56719c448ba42fef28cbee/sound/usb/quirks.c
---
--- a/sound/usb/format.c
+++ b/sound/usb/format.c
@@ -47,6 +47,7 @@
 {
 	int sample_width, sample_bytes;
 	u64 pcm_formats = 0;
+	bool dsd_raw = false;
 
 	switch (fp->protocol) {
 	case UAC_VERSION_1:
@@ -63,8 +64,10 @@
 		sample_width = fmt->bBitResolution;
 		sample_bytes = fmt->bSubslotSize;
 
-		if (format & UAC2_FORMAT_TYPE_I_RAW_DATA)
+		if (format & UAC2_FORMAT_TYPE_I_RAW_DATA) {
 			pcm_formats |= SNDRV_PCM_FMTBIT_SPECIAL;
+			dsd_raw = true;
+		}
 
 		format <<= 1;
 		break;
@@ -141,7 +144,8 @@
 			 fp->iface, fp->altsetting, format);
 	}
 
-	pcm_formats |= snd_usb_interface_dsd_format_quirks(chip, fp, sample_bytes);
+	pcm_formats |= snd_usb_interface_dsd_format_quirks(chip, fp, sample_bytes,
+						     dsd_raw);
 
 	return pcm_formats;
 }
--- a/sound/usb/quirks.c
+++ b/sound/usb/quirks.c
@@ -1154,18 +1154,28 @@
 	return false;
 }
 
-/* Marantz/Denon USB DACs need a vendor cmd to switch
+/* ITF-USB DSD DACs need a vendor cmd to switch
  * between PCM and native DSD mode
  */
-static bool is_marantz_denon_dac(unsigned int id)
+static bool is_itf_usb_dsd_dac(unsigned int id)
 {
 	switch (id) {
+	case USB_ID(0x154e, 0x1002): /* Denon DCD-1500RE */
 	case USB_ID(0x154e, 0x1003): /* Denon DA-300USB */
 	case USB_ID(0x154e, 0x3005): /* Marantz HD-DAC1 */
 	case USB_ID(0x154e, 0x3006): /* Marantz SA-14S1 */
+	case USB_ID(0x1852, 0x5062): /* Luxman D-08u */
+	case USB_ID(0x0644, 0x806b): /* TEAC UD-701 */
+	case USB_ID(0x0644, 0x807d): /* TEAC UD-507 */
+	case USB_ID(0x0644, 0x806c): /* Esoteric XD */
+
+	case USB_ID(0x1852, 0x5065): /* Luxman DA-06 */
+	case USB_ID(0x0644, 0x8043): /* TEAC UD-501/UD-501V2/UD-503/NT-503 */
+	case USB_ID(0x0644, 0x8044): /* Esoteric D-05X */
+	case USB_ID(0x0644, 0x804a): /* TEAC UD-301 */
 		return true;
 	}
-	return false;
+	return USB_ID_VENDOR(id) == 0x3255; /* Luxman D-10X wildcard */
 }
 
 int snd_usb_select_mode_quirk(struct snd_usb_substream *subs,
@@ -1174,7 +1184,7 @@
 	struct usb_device *dev = subs->dev;
 	int err;
 
-	if (is_marantz_denon_dac(subs->stream->chip->usb_id)) {
+	if (is_itf_usb_dsd_dac(subs->stream->chip->usb_id)) {
 		/* First switch to alt set 0, otherwise the mode switch cmd
 		 * will not be accepted by the DAC
 		 */
@@ -1184,16 +1194,13 @@
 
 		mdelay(20); /* Delay needed after setting the interface */
 
-		switch (fmt->altsetting) {
-		case 2: /* DSD mode requested */
-		case 1: /* PCM mode requested */
-			err = snd_usb_ctl_msg(dev, usb_sndctrlpipe(dev, 0), 0,
-					      USB_DIR_OUT|USB_TYPE_VENDOR|USB_RECIP_INTERFACE,
-					      fmt->altsetting - 1, 1, NULL, 0);
-			if (err < 0)
-				return err;
-			break;
-		}
+		/* Select native DSD or restore PCM/DoP mode. */
+		err = snd_usb_ctl_msg(dev, usb_sndctrlpipe(dev, 0), 0,
+				      USB_DIR_OUT|USB_TYPE_VENDOR|USB_RECIP_INTERFACE,
+				      !!(fmt->formats & SNDRV_PCM_FMTBIT_DSD_U32_BE),
+				      1, NULL, 0);
+		if (err < 0)
+			return err;
 		mdelay(20);
 	}
 	return 0;
@@ -1256,10 +1263,10 @@
 	    (requesttype & USB_TYPE_MASK) == USB_TYPE_CLASS)
 		mdelay(20);
 
-	/* Marantz/Denon devices with USB DAC functionality need a delay
+	/* ITF-USB DSD devices need a delay
 	 * after each class compliant request
 	 */
-	if (is_marantz_denon_dac(USB_ID(le16_to_cpu(dev->descriptor.idVendor),
+	if (is_itf_usb_dsd_dac(USB_ID(le16_to_cpu(dev->descriptor.idVendor),
 					le16_to_cpu(dev->descriptor.idProduct)))
 	    && (requesttype & USB_TYPE_MASK) == USB_TYPE_CLASS)
 		mdelay(20);
@@ -1271,6 +1278,65 @@
 	    (le16_to_cpu(dev->descriptor.idProduct) == 0x00dd) &&
 	    (requesttype & USB_TYPE_MASK) == USB_TYPE_CLASS)
 		mdelay(1);
+}
+
+/*
+ * Apply current Linux DSD_RAW vendor/device matches without quirk flags.
+ * Exact device entries take priority over vendor entries.
+ */
+static bool is_dsd_raw_device(unsigned int id)
+{
+	switch (id) {
+	case USB_ID(0x152a, 0x880a): /* NeuralDSP Quad Cortex */
+	case USB_ID(0x2772, 0x0502): /* Musical Fidelity M6s DAC */
+	case USB_ID(0x2fc6, 0xf06b): /* MOONDROP Moonriver2 Ti */
+	case USB_ID(0x2fc6, 0xf0b5): /* iBasso DC-Elite */
+	case USB_ID(0x2fc6, 0xf0b7): /* iBasso DC07 Pro */
+		return false;
+	case USB_ID(0x0661, 0x0883): /* iBasso DC04 Ultra */
+	case USB_ID(0x152a, 0x85dd): /* SMSL USB DAC */
+	case USB_ID(0x154e, 0x300b): /* Marantz SA-KI RUBY / SA-12 */
+	case USB_ID(0x16d0, 0x0ab1): /* PureAudio APA DAC */
+	case USB_ID(0x16d0, 0xeca1): /* PureAudio Lotus DAC5, DAC5 SE and DAC5 Pro */
+	case USB_ID(0x20b1, 0x2009): /* XMOS Ltd DIYINHK USB Audio 2.0 */
+	case USB_ID(0x21b4, 0x0230): /* Ayre QB-9 Twenty */
+	case USB_ID(0x21b4, 0x0232): /* Ayre QX-5 Twenty */
+	case USB_ID(0x22e8, 0xca10): /* Cambridge Audio streamers */
+	case USB_ID(0x262a, 0x9302): /* ddHiFi TC44C */
+	case USB_ID(0x32bb, 0x0004): /* HiBy FC4 */
+	case USB_ID(0x35d8, 0x011d): /* MOONDROP DAWN PRO2 */
+		return true;
+	default:
+		break;
+	}
+
+	switch (USB_ID_VENDOR(id)) {
+	case 0x1511: /* AURALiC */
+	case 0x152a: /* Thesycon devices */
+	case 0x18d1: /* iBasso devices */
+	case 0x20b1: /* XMOS based devices */
+	case 0x21ed: /* Accuphase Laboratory */
+	case 0x22d9: /* Oppo */
+	case 0x23ba: /* Playback Design */
+	case 0x25ce: /* Mytek devices */
+	case 0x2622: /* IAG Limited devices */
+	case 0x2772: /* Musical Fidelity devices */
+	case 0x278b: /* Rotel? */
+	case 0x292b: /* Gustard/Ess based devices */
+	case 0x2972: /* FiiO devices */
+	case 0x2ab6: /* T+A devices */
+	case 0x2afd: /* McIntosh Laboratory, Inc. */
+	case 0x2d87: /* Cayin device */
+	case 0x2fc6: /* Comture-inc devices */
+	case 0x3336: /* HEM devices */
+	case 0x3353: /* Khadas devices */
+	case 0x35f4: /* MSB Technology */
+	case 0x3842: /* EVGA */
+	case 0xc502: /* HiBy devices */
+		return true;
+	default:
+		return false;
+	}
 }
 
 /*
@@ -1282,10 +1348,14 @@
  */
 u64 snd_usb_interface_dsd_format_quirks(struct snd_usb_audio *chip,
 					struct audioformat *fp,
-					unsigned int sample_bytes)
-{
+					unsigned int sample_bytes,
+					bool dsd_raw)
+{
+	struct usb_interface *iface;
+
 	/* Playback Designs */
-	if (le16_to_cpu(chip->dev->descriptor.idVendor) == 0x23ba) {
+	if (USB_ID_VENDOR(chip->usb_id) == 0x23ba &&
+	    (chip->usb_id & 0xffff) < 0x0110) {
 		switch (fp->altsetting) {
 		case 1:
 			fp->dsd_dop = true;
@@ -1301,6 +1371,12 @@
 
 	/* XMOS based USB DACs */
 	switch (chip->usb_id) {
+	case USB_ID(0x139f, 0x5504): /* Nagra DAC */
+	case USB_ID(0x20b1, 0x3089): /* Mola-Mola DAC */
+	case USB_ID(0x2522, 0x0007): /* LH Labs Geek Out 1V5 */
+	case USB_ID(0x2522, 0x0009): /* LH Labs Geek Pulse X Inifinity 2V0 */
+	case USB_ID(0x2522, 0x0012): /* LH Labs VI DAC Infinity */
+	case USB_ID(0x2772, 0x0230): /* Pro-Ject Pre Box S2 Digital */
 	case USB_ID(0x20b1, 0x3008): /* iFi Audio micro/nano iDSD */
 	case USB_ID(0x20b1, 0x2008): /* Matrix Audio X-Sabre */
 	case USB_ID(0x20b1, 0x300a): /* Matrix Audio Mini-i Pro */
@@ -1313,19 +1389,61 @@
 	case USB_ID(0x20b1, 0x2009): /* DIYINHK DSD DXD 384kHz USB to I2S/DSD */
 	case USB_ID(0x20b1, 0x2023): /* JLsounds I2SoverUSB */
 	case USB_ID(0x20b1, 0x3023): /* Aune X1S 32BIT/384 DSD DAC */
+	case USB_ID(0x0d8c, 0x0316): /* Hegel HD12 DSD */
+	case USB_ID(0x16d0, 0x06b4): /* NuPrime Audio HD-AVP/AVA */
+	case USB_ID(0x16d0, 0x09d8): /* NuPrime IDA-8 */
+	case USB_ID(0x16d0, 0x0ab1): /* PureAudio APA DAC */
+	case USB_ID(0x16d0, 0xeca1): /* PureAudio Lotus DAC5, DAC5 SE and DAC5 Pro */
+	case USB_ID(0x20a0, 0x4143): /* WaveIO USB Audio 2.0 */
+	case USB_ID(0x2622, 0x0061): /* LEAK Stereo 230 */
+	case USB_ID(0x278b, 0x5100): /* Rotel RC-1590 */
+	case USB_ID(0x10cb, 0x0103): /* Native DSD */
+	case USB_ID(0x16d0, 0x06b2): /* NuPrime DAC-10 */
+	case USB_ID(0x16d0, 0x09dd): /* Encore mDSD */
+	case USB_ID(0x16d0, 0x0733): /* Furutech ADL Stratos */
+	case USB_ID(0x16d0, 0x09db): /* NuPrime Audio DAC-9 */
+	case USB_ID(0x1db5, 0x0003): /* Bryston BDA3 */
+	case USB_ID(0x22e1, 0xca01): /* HDTA Serenade DSD */
+	case USB_ID(0x249c, 0x9326): /* M2Tech Young MkIII */
+	case USB_ID(0x2622, 0x0041): /* Audiolab M-DAC+ */
+	case USB_ID(0x27f7, 0x3002): /* W4S DAC-2v2SE */
+	case USB_ID(0x29a2, 0x0086): /* Mutec MC3+ USB */
+	case USB_ID(0x6b42, 0x0042): /* MSB Technology */
 	case USB_ID(0x2616, 0x0106): /* PS Audio NuWave DAC */
 		if (fp->altsetting == 3)
 			return SNDRV_PCM_FMTBIT_DSD_U32_BE;
 		break;
-	default:
-		break;
-	}
-
-	/* Denon/Marantz devices with USB DAC functionality */
-	if (is_marantz_denon_dac(chip->usb_id)) {
+	case USB_ID(0x16d0, 0x071a): /* Amanero Combo384 */
+		if (fp->altsetting == 2) {
+			switch (le16_to_cpu(chip->dev->descriptor.bcdDevice)) {
+			case 0x199:
+				return SNDRV_PCM_FMTBIT_DSD_U32_LE;
+			case 0x19b:
+			case 0x203:
+				return SNDRV_PCM_FMTBIT_DSD_U32_BE;
+			default:
+				break;
+			}
+		}
+		break;
+	case USB_ID(0x16d0, 0x0a23):
 		if (fp->altsetting == 2)
 			return SNDRV_PCM_FMTBIT_DSD_U32_BE;
-	}
-
-	return 0;
-}
+		break;
+	default:
+		break;
+	}
+
+	/* ITF-USB DSD DACs use their last alternate setting. */
+	if (is_itf_usb_dsd_dac(chip->usb_id)) {
+		iface = usb_ifnum_to_if(chip->dev, fp->iface);
+		if (iface && fp->altsetting == iface->num_altsetting - 1)
+			return SNDRV_PCM_FMTBIT_DSD_U32_BE;
+	}
+
+	/* RAW_DATA is DSD only for known implementations. */
+	if (dsd_raw && is_dsd_raw_device(chip->usb_id))
+		return SNDRV_PCM_FMTBIT_DSD_U32_BE;
+
+	return 0;
+}
--- a/sound/usb/quirks.h
+++ b/sound/usb/quirks.h
@@ -38,6 +38,7 @@
 
 u64 snd_usb_interface_dsd_format_quirks(struct snd_usb_audio *chip,
 					struct audioformat *fp,
-					unsigned int sample_bytes);
+					unsigned int sample_bytes,
+					bool dsd_raw);
 
 #endif /* __USBAUDIO_QUIRKS_H */
