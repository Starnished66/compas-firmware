+/* HiBy: a paused or muted source can keep sending a tiny repeating signal,
+ * which makes the R1's DAC whistle. True for samples that all stay within one
+ * 16-bit step of zero (about -90 dBFS). */
+static bool pcm_is_near_silent(snd_pcm_format_t format, const void *data, size_t samples) {
+	const int16_t *s16 = data;
+	const int32_t *s32 = data;
+	const int32_t limit = format == SND_PCM_FORMAT_S32_LE ? 1 << 16 : 1 << 8;
+	switch (format) {
+	case SND_PCM_FORMAT_S16_LE:
+		for (size_t i = 0; i < samples; i++)
+			if (s16[i] > 1 || s16[i] < -1)
+				return false;
+		return true;
+	case SND_PCM_FORMAT_S24_LE:
+	case SND_PCM_FORMAT_S32_LE:
+		for (size_t i = 0; i < samples; i++)
+			if (s32[i] > limit || s32[i] < -limit)
+				return false;
+		return true;
+	default:
+		return false;
+	}
+}
