--- a/usr/bin/bt_init
+++ b/usr/bin/bt_init
@@ -1,5 +1,34 @@
 #!/bin/sh
 
+# Keep both radios off at boot; start the userspace Bluetooth services only.
+if [ -f /run/aic_combo_power_gate ] || [ -f /run/aic_bt_power_gate ]; then
+	if ! pidof dbus-daemon >/dev/null; then
+		rm /var/run/messagebus.pid -rf
+		mkdir -p /tmp/dbus
+		mkdir -p /var/lib/dbus
+		dbus-uuidgen > /var/lib/dbus/machine-id
+		dbus-daemon --config-file=/usr/share/dbus-1/system.conf
+	fi
+
+	/usr/libexec/bluetooth/bluetoothd -E -C &
+
+	echo "* 0000" > /usr/data/pin.conf
+	chmod 600 /usr/data/pin.conf
+	bt-agent -c NoInputNoOutput -p /usr/data/pin.conf &
+
+	/usr/bin/bluealsad -p a2dp-source &
+
+	exit 0
+fi
+
+if [ -r /run/r1_wireless_type ] && [ "$(cat /run/r1_wireless_type)" = "aic" ]; then
+	count=0
+	while [ ! -e "/sys/class/net/wlan0" ] && [ "$count" != "350" ]; do
+		sleep 0.1
+		count=$((count + 1))
+	done
+fi
+
