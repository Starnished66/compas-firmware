+
+# Detect chip type via SDIO modalias.
+for sdio_path in "$SDIO_MMC0_ROOT"/mmc0:*; do
+    [ -d "$sdio_path" ] || continue
+    sdio_name=$(basename "$sdio_path")
+
+    for func in 1 2; do
+        MODALIAS_FILE="$sdio_path/$sdio_name:$func/modalias"
+        [ -f "$MODALIAS_FILE" ] || continue
+
+        modalias=$(cat "$MODALIAS_FILE")
+        vendor_id=$(echo "$modalias" | sed -n 's/.*v\([0-9A-Fa-f]\{4\}\).*/\1/p' | tr '[:upper:]' '[:lower:]')
+        device_id=$(echo "$modalias" | sed -n 's/.*d\([0-9A-Fa-f]\{4\}\).*/\1/p' | tr '[:upper:]' '[:lower:]')
+
+        [ -n "$vendor_id" ] && [ -n "$device_id" ] || continue
+
+        if [ "$vendor_id" = "c8a1" ]; then
+            chip_type="aic8800"
+            echo "Detected AIC8800 chip via SDIO (vid=$vendor_id, did=$device_id)"
+            break 2
+        elif [ "$vendor_id" = "02d0" ]; then
+            case "$device_id" in
+                # AP6255 ---- BCM4345C5
+                a9bf|4345|0812)
+                    chip_type="bcm4345c5"
+                    firmware="BCM4345C5_003.006.006.0058.0135.hcd"
+                    break 2
+                    ;;
+                # AP6212 / AW-NB372SM --- BCM4343A1
+                a9a6|0726|4343)
+                    CHIPVENDOR="$sdio_path/$sdio_name:2/chipvendor"
+                    if [ -f "$CHIPVENDOR" ]; then
+                        chipvendor=$(cat "$CHIPVENDOR")
+                        case "$chipvendor" in
+                            0x81)
+                                chip_type="bcm4343a1_aw"
+                                firmware="BCM4343A1_001.002.009.0122.0538.hcd"
+                                ;;
+                            *)
+                                chip_type="bcm4343a1"
+                                firmware="BCM4343A1_001.002.009.1010.1030.hcd"
+                                ;;
+                        esac
+                    else
                         chip_type="bcm4343a1_aw"
                         firmware="BCM4343A1_001.002.009.0122.0538.hcd"
-            ;;
-        *)
-            #AP6212 
-                        chip_type="bcm4343a1"
