+    if [ -d /sys/module/aic8800_fdrv ]; then
+        rm -f "$AIC_FDRV_SUSPEND_MARKER"
+    elif [ -f /module_driver/aic8800_fdrv.r1 ]; then
+        # The R1 loader carries product-specific options such as disable_5g=1.
+        if (cd /module_driver && sh ./aic8800_fdrv.r1); then
+            rm -f "$AIC_FDRV_SUSPEND_MARKER"
+        fi
+    elif insmod /module_driver/aic8800_fdrv.ko; then
+        rm -f "$AIC_FDRV_SUSPEND_MARKER"
+    fi
+fi
