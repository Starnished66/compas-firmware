/.claude/
/release/
/toolchains/
/player/

# Tests are local only.
/scripts/tests/
/scripts/fixtures/
/scripts/kernel/**/tests/
/scripts/kernel/**/test_*
/scripts/kernel/**/*_test.c
/scripts/kernel/**/*_harness.c
