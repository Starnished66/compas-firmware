msgid "File unavailable"
msgstr "Tệp không có sẵn"

msgid "Unsupported audio format"
msgstr "Định dạng âm thanh không được hỗ trợ"

msgid "Too many audio channels"
msgstr "Quá nhiều kênh âm thanh"

msgid "Audio output failed"
msgstr "Lỗi đầu ra âm thanh"

msgid "Audio could not be decoded"
msgstr "Không thể giải mã âm thanh"

msgid "Playback error"
msgstr "Lỗi phát lại"

msgid "No SD card is mounted."
msgstr "Chưa gắn thẻ SD."

msgid "The firmware path is too long."
msgstr "Đường dẫn firmware quá dài."

msgid "Use a regular %s file in the SD card root."
msgstr "Sử dụng tệp %s thông thường trong thư mục gốc của thẻ SD."

msgid "Could not prepare update helper: %s"
msgstr "Không thể chuẩn bị trình trợ giúp cập nhật: %s"

msgid "Could not start update helper: %s"
msgstr "Không thể bắt đầu trình trợ giúp cập nhật: %s"

msgid "Update helper failed (%s, status %d). See .compas/ota/update.log."
msgstr "Trình trợ giúp cập nhật không thành công (%s, trạng thái %d). Xem .compas/ota/update.log."

msgid "Cannot read update helper status: %s"
msgstr "Không thể đọc trạng thái trợ giúp cập nhật: %s"

msgid "Still working. Do not turn off the player or retry."
msgstr "Đang xử lý. Đừng tắt máy nghe nhạc và đừng thử lại."

msgid "Recovery flag partition does not match this firmware."
msgstr "Phân vùng cờ khôi phục không khớp với firmware này."

msgid "Cannot safely access the recovery flag block."
msgstr "Không thể truy cập an toàn vào vùng lưu cờ khôi phục."

msgid "Recovery flag erase failed. Do not reboot; check .compas/ota/update.log."
msgstr "Không thể xóa cờ khôi phục. Đừng khởi động lại; hãy xem .compas/ota/update.log."

msgid "Recovery flag write failed. Do not reboot; check .compas/ota/update.log."
msgstr "Không thể ghi cờ khôi phục. Đừng khởi động lại; hãy xem .compas/ota/update.log."

msgid "Recovery flag verification failed. Do not reboot; check the update log."
msgstr "Không thể xác minh cờ khôi phục. Đừng khởi động lại; hãy xem nhật ký cập nhật."

msgid "The selected update file changed. Select it again."
msgstr "Tệp cập nhật đã chọn đã thay đổi. Hãy chọn lại."

msgid "Cannot read the selected update file."
msgstr "Không thể đọc tệp cập nhật đã chọn."

msgid "Cannot create the update log directory."
msgstr "Không thể tạo thư mục nhật ký cập nhật."

msgid "Update diagnostics must be stored on the SD card."
msgstr "Chẩn đoán cập nhật phải được lưu trữ trên thẻ SD."

msgid "Cannot save update diagnostics on the SD card."
msgstr "Không thể lưu chẩn đoán cập nhật trên thẻ SD."

msgid "The update file changed during verification. Select it again."
msgstr "Tệp cập nhật đã thay đổi trong khi xác minh. Hãy chọn lại."

msgid "Could not move other .upt files aside on the SD card."
msgstr "Không thể di chuyển các tệp .upt khác sang một bên trên thẻ SD."

msgid "A required recovery helper is missing. Update preparation stopped."
msgstr "Thiếu trợ giúp khôi phục cần thiết. Quá trình chuẩn bị cập nhật đã dừng lại."

msgid "Cannot save update diagnostics. Update preparation stopped."
msgstr "Không thể lưu chẩn đoán cập nhật. Quá trình chuẩn bị cập nhật đã dừng lại."

msgid "Recovery boot flag failed."
msgstr "Cờ khởi động khôi phục không thành công."

msgid "Recovery remains selected. Keep the update file; saving diagnostics failed."
msgstr "Chế độ khôi phục vẫn được chọn. Giữ tệp cập nhật; không lưu được thông tin chẩn đoán."

msgid "Saving data failed. Recovery remains selected; keep the update file and check .compas/ota/update.log."
msgstr "Không thể lưu dữ liệu. Chế độ khôi phục vẫn được chọn; hãy giữ tệp cập nhật và xem .compas/ota/update.log."

msgid "Recovery remains selected but reboot failed: %s. Keep the update file."
msgstr "Chế độ khôi phục vẫn được chọn nhưng không khởi động lại được: %s. Giữ tệp cập nhật."

msgid "An update is already in progress."
msgstr "Đang có bản cập nhật khác."

msgid "Charge to at least 30%% or connect power before updating."
msgstr "Sạc tới ít nhất 30%% hoặc kết nối nguồn trước khi cập nhật."

msgid "Invalid update path."
msgstr "Đường dẫn cập nhật không hợp lệ."

msgid "Could not start the update."
msgstr "Không thể bắt đầu cập nhật."

msgid "Update failed."
msgstr "Cập nhật không thành công."

msgid "Could not prepare secure update storage."
msgstr "Không thể chuẩn bị bộ nhớ cập nhật an toàn."

msgid "Could not download the release checksums."
msgstr "Không thể tải xuống tổng kiểm tra bản phát hành."

msgid "The release does not provide a valid player checksum."
msgstr "Bản phát hành không có mã kiểm tra hợp lệ cho trình phát."

msgid "The release checksum does not match the published asset digest."
msgstr "Tổng kiểm tra bản phát hành không khớp với thông báo nội dung đã xuất bản."

msgid "The latest player release changed. Check again."
msgstr "Bản phát hành trình phát mới nhất đã thay đổi. Hãy kiểm tra lại."

msgid "The player image exceeds the safe size limit."
msgstr "Hình ảnh trình phát vượt quá giới hạn kích thước an toàn."

msgid "Not enough internal storage for the player update."
msgstr "Không đủ bộ nhớ trong để cập nhật trình phát."

msgid "The player download did not complete."
msgstr "Tải trình phát xuống chưa hoàn tất."

msgid "The downloaded player failed SHA-256 verification."
msgstr "Không xác minh được SHA-256 của trình phát đã tải xuống."

msgid "Place a valid player executable at SD/.compas/compas_player."
msgstr "Đặt trình phát thực thi hợp lệ tại SD/.compas/compas_player."

msgid "Could not start the player update check."
msgstr "Không thể bắt đầu kiểm tra cập nhật trình phát."

msgid "Another update is already active."
msgstr "Đang có bản cập nhật khác."

msgid "Check for a player update first."
msgstr "Trước tiên, hãy kiểm tra bản cập nhật cho trình phát."

msgid "Not enough memory."
msgstr "Không đủ bộ nhớ."

msgid "Could not start the player download."
msgstr "Không thể bắt đầu tải xuống trình phát."

msgid "Could not start the SD player update."
msgstr "Không thể bắt đầu cập nhật trình phát SD."

msgid "Screenshots unavailable"
msgstr "Không thể chụp ảnh màn hình"

msgid "Screenshot needs an SD card"
msgstr "Cần có thẻ SD để chụp ảnh màn hình"

msgid "Disconnect USB storage first"
msgstr "Trước tiên hãy ngắt kết nối bộ lưu trữ USB"

msgid "Screenshot failed (framebuffer)"
msgstr "Ảnh chụp màn hình không thành công (bộ đệm khung)"

msgid "Screenshot failed (worker)"
msgstr "Chụp ảnh màn hình thất bại (tiến trình nền)"

msgid "Files"
msgstr "Tập tin"

msgid "Artists"
msgstr "Nghệ sĩ"

msgid "Albums"
msgstr "Album"

msgid "Album Artist"
msgstr "Nghệ sĩ album"

msgid "Genres"
msgstr "Thể loại"

msgid "All Songs"
msgstr "Tất cả bài hát"

msgid "Playlists"
msgstr "Danh sách phát"

msgid "Sound"
msgstr "Âm thanh"

msgid "Playback"
msgstr "Phát lại"

msgid "Library"
msgstr "Thư viện"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Bluetooth"
msgstr "Bluetooth"

msgid "Sleep Timer"
msgstr "Hẹn giờ ngủ"

msgid "Crossfade"
msgstr "Đan xen"

msgid "AirPlay"
msgstr "AirPlay"

msgid "DLNA"
msgstr "DLNA"

msgid "Gapless"
msgstr "Phát liền mạch"

msgid "Remote Control"
msgstr "Điều khiển từ xa"

msgid "Car Mode"
msgstr "Chế độ ô tô"

msgid "Plugins"
msgstr "Plugin"

msgid "Page %d of %d"
msgstr "%d/%d trang"

msgid "Go to page"
msgstr "Đi tới trang"

msgid "Cancel"
msgstr "Hủy bỏ"

msgid "Previous"
msgstr "Trước đó"

msgid "Next"
msgstr "Tiếp theo"

msgid "Folder too large to index (tap Back)"
msgstr "Thư mục quá lớn để lập chỉ mục (nhấn Quay lại)"

msgid "Unable to read folder (tap Back and retry)"
msgstr "Không thể đọc thư mục (nhấn Quay lại và thử lại)"

msgid "This folder is empty"
msgstr "Thư mục này trống"

msgid "No playable files here"
msgstr "Không có tệp nào có thể phát trong thư mục này"

msgid "No playable audio files found"
msgstr "Không tìm thấy tệp âm thanh có thể phát được"

msgid "Open a folder containing supported audio files."
msgstr "Mở thư mục chứa các tập tin âm thanh được hỗ trợ."

msgid "Unexpected reply from GitHub."
msgstr "GitHub phản hồi không hợp lệ."

msgid "Insert an SD card to change emulators."
msgstr "Lắp thẻ SD để thay đổi trình giả lập."

msgid "Cannot create the emulator folder."
msgstr "Không thể tạo thư mục giả lập."

msgid "The emulator folder is not writable."
msgstr "Thư mục giả lập không thể ghi được."

msgid "Not enough free space on the player."
msgstr "Không đủ dung lượng trống trên máy nghe nhạc."

msgid "Could not read the emulator list from GitHub."
msgstr "Không thể đọc danh sách trình giả lập từ GitHub."

msgid "This emulator needs a newer player version."
msgstr "Trình giả lập này cần phiên bản trình phát mới hơn."

msgid "Disconnect USB storage from the host before changing emulators."
msgstr "Ngắt bộ nhớ USB khỏi máy chủ trước khi đổi trình giả lập."

msgid "Could not install the emulator."
msgstr "Không thể cài đặt trình giả lập."

msgid "The emulator download failed verification. Try again."
msgstr "Không xác minh được tệp trình giả lập đã tải xuống. Hãy thử lại."

msgid "Could not start the emulator operation"
msgstr "Không thể bắt đầu thao tác với trình giả lập"

msgid "Could not remove the emulator."
msgstr "Không thể gỡ trình giả lập."

msgid "Unexpected reply from GitHub"
msgstr "GitHub phản hồi không hợp lệ"

msgid "GitHub's latest release is not a supported firmware release."
msgstr "Bản phát hành mới nhất của GitHub không phải là bản phát hành firmware được hỗ trợ."

msgid "GitHub's latest release has no valid %s image and checksum."
msgstr "Bản phát hành mới nhất của GitHub không có hình ảnh và tổng kiểm tra %s hợp lệ."

msgid "Secure connection failed. Check Wi-Fi and the date and time."
msgstr "Kết nối an toàn không thành công. Kiểm tra Wi-Fi và ngày giờ."

msgid "Cannot reach GitHub. Check the Wi-Fi connection."
msgstr "Không thể truy cập GitHub. Kiểm tra kết nối Wi-Fi."

msgid "GitHub did not respond in time. Try again."
msgstr "GitHub không phản hồi kịp thời. Hãy thử lại."

msgid "Could not read the release list from GitHub."
msgstr "Không thể đọc danh sách bản phát hành từ GitHub."

msgid "GitHub is limiting requests. Try again later."
msgstr "GitHub đang hạn chế yêu cầu. Hãy thử lại sau."

msgid "GitHub returned HTTP %d."
msgstr "GitHub trả về mã HTTP %d."

msgid "Cannot read the SD card."
msgstr "Không thể đọc thẻ SD."

msgid "A newer or changed release is available. Check for updates again before downloading."
msgstr "Đã có bản phát hành mới hơn hoặc đã thay đổi. Hãy kiểm tra cập nhật lần nữa trước khi tải xuống."

msgid "Insert an SD card to download the update."
msgstr "Lắp thẻ SD để tải xuống bản cập nhật."

msgid "The release has no checksum for this device's image."
msgstr "Bản phát hành không có tổng kiểm tra cho hình ảnh của thiết bị này."

msgid "This release's image does not match its checksums. Try again after the next weekly release."
msgstr "Hình ảnh của bản phát hành này không khớp với tổng kiểm tra của nó. Hãy thử lại sau lần phát hành hàng tuần tiếp theo."

msgid "Not enough free space on the SD card for the update."
msgstr "Không đủ dung lượng trống trên thẻ SD để cập nhật."

msgid "The download did not complete. Check Wi-Fi and try again."
msgstr "Quá trình tải xuống không hoàn tất. Hãy kiểm tra Wi-Fi và thử lại."

msgid "The downloaded image failed verification and was deleted."
msgstr "Hình ảnh đã tải xuống không được xác minh và đã bị xóa."

msgid "The SD card changed during the download."
msgstr "Thẻ SD đã thay đổi trong quá trình tải xuống."

msgid "Could not record the verified update on the SD card."
msgstr "Không thể ghi lại bản cập nhật đã xác minh trên thẻ SD."

msgid "Could not place the update on the SD card."
msgstr "Không thể đặt bản cập nhật vào thẻ SD."

msgid "Could not start the update check."
msgstr "Không thể bắt đầu kiểm tra cập nhật."

msgid "Could not start the download."
msgstr "Không thể bắt đầu tải xuống."

msgid "No verified update is on this SD card. Download it again."
msgstr "Không có bản cập nhật được xác minh nào trên thẻ SD này. Tải xuống lại."

msgid "Cannot read the update file on the SD card. Check the card and try again."
msgstr "Không thể đọc tệp cập nhật trên thẻ SD. Hãy kiểm tra thẻ và thử lại."

msgid "The update file on the SD card changed. Download it again."
msgstr "Tệp cập nhật trên thẻ SD đã thay đổi. Tải xuống lại."

msgid "This update is no longer the latest release. Check for updates and download the latest image."
msgstr "Bản cập nhật này không còn là bản phát hành mới nhất. Kiểm tra cập nhật và tải xuống hình ảnh mới nhất."

msgid "Could not verify the latest release checksums."
msgstr "Không thể xác minh tổng kiểm tra bản phát hành mới nhất."

msgid "This update no longer matches the latest release. Download the latest image again."
msgstr "Bản cập nhật này không còn phù hợp với bản phát hành mới nhất. Tải lại hình ảnh mới nhất một lần nữa."

msgid "Could not enter recovery mode."
msgstr "Không thể vào chế độ phục hồi."

msgid "Charge to at least %d%% or connect power before updating."
msgstr "Sạc tới ít nhất %d%% hoặc kết nối nguồn trước khi cập nhật."

msgid "A firmware update is already in progress."
msgstr "Một bản cập nhật firmware đang được tiến hành."

msgid "Could not start the installation."
msgstr "Không thể bắt đầu cài đặt."

msgid "Disconnect USB storage from the host before changing plugins."
msgstr "Ngắt kết nối bộ lưu trữ USB khỏi máy chủ trước khi thay đổi plugin."

msgid "Cannot check plugin storage write access."
msgstr "Không thể kiểm tra quyền truy cập ghi vào bộ nhớ plugin."

msgid "The SD card is read-only. Check its write protection."
msgstr "Thẻ SD ở chế độ chỉ đọc. Kiểm tra khả năng bảo vệ ghi của nó."

msgid "Plugin storage is unavailable."
msgstr "Bộ nhớ plugin không có sẵn."

msgid "The SD card changed during the operation."
msgstr "Thẻ SD đã thay đổi trong khi thao tác."

msgid "Could not read the plugin list from GitHub."
msgstr "Không thể đọc danh sách plugin từ GitHub."

msgid "Insert an SD card to install plugins."
msgstr "Lắp thẻ SD để cài đặt plugin."

msgid "Could not read installed plugins."
msgstr "Không thể đọc các plugin đã cài đặt."

msgid "The installed plugins record is damaged. Remove or repair .plugins/.store_installed on the SD card."
msgstr "Bản ghi plugin đã cài đặt bị hỏng. Hãy xóa hoặc sửa .plugins/.store_installed trên thẻ SD."

msgid "This plugin needs a newer player version."
msgstr "Plugin này cần phiên bản trình phát mới hơn."

msgid "Too many plugins are installed. Remove one and try again."
msgstr "Quá nhiều plugin được cài đặt. Hãy xóa một cái và thử lại."

msgid "This plugin is already installed by the store."
msgstr "Plugin này đã được cài đặt từ cửa hàng."

msgid "This plugin has no update available."
msgstr "Plugin này không có bản cập nhật nào."

msgid "Not enough free space on the SD card."
msgstr "Không đủ dung lượng trống trên thẻ SD."

msgid "The plugin download failed verification. Try again."
msgstr "Việc tải xuống plugin không thể xác minh được. Hãy thử lại."

msgid "A local plugin file will be replaced. Confirm to continue."
msgstr "Tệp plugin trên thiết bị sẽ bị thay thế. Xác nhận để tiếp tục."

msgid "Could not install the plugin on the SD card."
msgstr "Không thể cài đặt plugin trên thẻ SD."

msgid "Insert an SD card to change plugins."
msgstr "Lắp thẻ SD để thay đổi plugin."

msgid "Could not start the plugin operation."
msgstr "Không thể bắt đầu hoạt động của plugin."

msgid "Could not start the plugin refresh."
msgstr "Không thể bắt đầu làm mới plugin."

msgid "Insert an SD card to remove plugins."
msgstr "Lắp thẻ SD để xóa plugin."

msgid "This plugin is not installed by the store."
msgstr "Plugin này không được cài đặt bởi cửa hàng."

msgid "Could not prepare plugin removal."
msgstr "Không thể chuẩn bị gỡ bỏ plugin."

msgid "Could not remove a plugin file."
msgstr "Không thể xóa tệp plugin."

msgid "Could not update the installed plugin record."
msgstr "Không thể cập nhật thông tin plugin đã cài đặt."

msgid "Insert an SD card to update plugins."
msgstr "Lắp thẻ SD để cập nhật plugin."

msgid "A plugin download failed verification. Try again."
msgstr "Quá trình xác minh tải xuống plugin không thành công. Hãy thử lại."

msgid "Could not install a plugin on the SD card."
msgstr "Không thể cài đặt plugin vào thẻ SD."

msgid "Some updates need confirmation before replacing local files."
msgstr "Cần xác nhận trước khi thay thế một số tệp trên thiết bị."

msgid "Could not start the plugin update."
msgstr "Không thể bắt đầu cập nhật plugin."

msgid "Unexpected library response"
msgstr "Phản hồi thư viện không mong đợi"

msgid "On"
msgstr "Bật"

msgid "Off"
msgstr "Tắt"

msgid "Screenshot saved"
msgstr "Đã lưu ảnh chụp màn hình"

msgid "Screenshot failed (%s)"
msgstr "Ảnh chụp màn hình không thành công (%s)"

msgid "unknown"
msgstr "Không rõ"

msgid "Cannot play folder"
msgstr "Không thể phát thư mục"

msgid "Paused: headphones disconnected"
msgstr "Đã tạm dừng: tai nghe đã bị ngắt kết nối"

msgid "Queue checkpoint failed; storage may be read-only"
msgstr "Điểm kiểm tra hàng đợi không thành công; bộ nhớ có thể ở chế độ chỉ đọc"

msgid "Playback history could not be saved"
msgstr "Không thể lưu lịch sử phát lại"

msgid "Subsonic"
msgstr "Subsonic"

msgid "Stream Media"
msgstr "Phát trực tuyến"

msgid "Could not open this file."
msgstr "Không thể mở tập tin này."

msgid "[File truncated at %d KB -- showing the first part only]\n\n%s"
msgstr "[Tệp bị cắt bớt ở %d KB - chỉ hiển thị phần đầu tiên]\n\n%s"

msgid "Books refreshed"
msgstr "Sách được làm mới"

msgid "Could not read the Books folder"
msgstr "Không thể đọc thư mục Books"

msgid "Could not refresh books"
msgstr "Không thể làm mới sách"

msgid "Favorites"
msgstr "Yêu thích"

msgid "Books"
msgstr "Sách"

msgid "No favorites yet"
msgstr "Chưa có mục yêu thích nào"

msgid "No books found"
msgstr "Không tìm thấy sách nào"

msgid "Open a book and tap the bookmark icon to save it here."
msgstr "Mở một cuốn sách và nhấn vào biểu tượng dấu trang để lưu nó ở đây."

msgid "Add .txt files to the Books folder, then refresh the library."
msgstr "Thêm tệp .txt vào thư mục Books, sau đó làm mới thư viện."

msgid "Needs newer firmware"
msgstr "Cần firmware mới hơn"

msgid "Update available · %s"
