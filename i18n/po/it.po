msgstr "Scrittura del flag di ripristino non riuscita. Non riavviare; controlla .compas/ota/update.log."

msgid "Recovery flag verification failed. Do not reboot; check the update log."
msgstr "Verifica del flag di ripristino non riuscita. Non riavviare; controlla il log di aggiornamento."

